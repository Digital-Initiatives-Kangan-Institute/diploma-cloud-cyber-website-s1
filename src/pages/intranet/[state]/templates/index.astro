---
/**
 * Per-state templates landing — placeholder until template documents are
 * migrated. Templates are eventually served as static .docx / .pptx files
 * from /public/downloads/ with metadata + a download link per item here.
 */

import IntranetLayout from '../../../../layouts/IntranetLayout.astro';
import { STATES } from '../../../../config/states';

export function getStaticPaths() {
  return STATES.map(s => ({
    params: { state: s.slug },
    props: { state: s },
  }));
}

const { state } = Astro.props;
const base = `/intranet/${state.slug}`;

// The Solution Design template has a web-scale variant (it adds Web-scale Design and
// Microservice & Serverless Design sections) for clusters whose design work scales a web
// application and includes a microservice — currently S1-CL2. Other clusters get the base
// template, whose shape is unchanged. Same on-page label either way.
const solutionDesignHref = state.slug.startsWith('s1-cl2')
  ? '/templates/YAT-Solution-Design-Template-Webscale.docx'
  : '/templates/YAT-Solution-Design-Template.docx';

// The Deployment Report template likewise has a serverless + infrastructure-as-code variant
// (its build narrative / testing sections cover operating IaC templates, authoring your own,
// and a microservice deploy) for S1-CL2 AT2. Other clusters get the base (EC2/RDS) template.
const deploymentReportHref = state.slug.startsWith('s1-cl2')
  ? '/templates/YAT-Deployment-Report-Template-Serverless.docx'
  : '/templates/YAT-Deployment-Report-Template.docx';

// The Team Plan template is specific to team-led engagements (S1-CL3, where a student team
// leads the improvement). Shown only in those states.
const isCl3 = state.slug.startsWith('s1-cl3');

// The Feedback Record template is specific to CL1 AT1, where feedback from the board
// presentation is captured as a standalone attachment rather than in-deliverable.
const isCl1 = state.slug.startsWith('s1-cl1');

// Available templates (static files under /public/templates/). Add entries here
// as further templates are finalised.
const templates = [
  ...(isCl3 ? [{
    title: 'Team Plan',
    description:
      'The YAT team plan template — team objectives and responsibilities, per-member performance expectations, accountability strategies, contingency planning, and task allocation. For an engagement led by a team. Complete the sections that apply.',
    href: '/templates/YAT-Team-Plan-Template.docx',
    format: 'DOCX',
  }] : []),
  {
    title: 'Business Case',
    description:
      'The YAT business case template — cover sheet, table of contents, and every section with built-in guidance, ready to complete.',
    href: '/templates/YAT-Business-Case-Template.docx',
    format: 'DOCX',
  },
  {
    title: 'Business Case Presentation',
    description:
      'The YAT board-presentation deck template — title, agenda, and every section with built-in guidance, ready to complete.',
    href: '/templates/YAT-Business-Case-Deck-Template.pptx',
    format: 'PPTX',
  },
  ...(isCl1 ? [{
    title: 'Feedback Record',
    description:
      'The YAT feedback record template — capture feedback received during a presentation or review event, your response, and the resulting action. Attach the completed record to your deliverable as directed by the assessment task.',
    href: '/templates/YAT-Feedback-Record-Template.docx',
    format: 'DOCX',
  }] : []),
  {
    title: 'Solution Design',
    description:
      'The YAT solution/architecture design template — for a greenfield design or for hardening an existing one. The design a deployment report then implements. Complete the sections that apply; mark the rest “Not applicable”.',
    href: solutionDesignHref,
    format: 'DOCX',
  },
  {
    title: 'Disaster Recovery Plan',
    description:
      'The YAT disaster recovery plan template — risk and impact analysis, recovery objectives (RTO/RPO), recovery strategy, the recovery runbook, and validation and sign-off. Complete the sections that apply; mark the rest “Not applicable”.',
    href: '/templates/YAT-DR-Plan-Template.docx',
    format: 'DOCX',
  },
  {
    title: 'Deployment Report',
    description:
      'The YAT deployment report template — one standard format for any deployment, from a foundation build to a full high-availability hardening. Complete the sections that apply; mark the rest “Not applicable”.',
    href: deploymentReportHref,
    format: 'DOCX',
  },
];
---

<IntranetLayout
  title="Templates"
  description={`YAT document templates — ${state.fullLabel}.`}
  breadcrumb={[
    { text: 'Intranet', href: `${base}/` },
    { text: 'Templates' },
  ]}
>
  <h1>Templates</h1>
  <p class="state-notation">Intranet state for {state.fullLabel}</p>

  <p class="lede">
    Document templates used across YAT projects and engagements. Download the
    relevant template, complete it for your work, and submit through your
    engagement's normal acceptance process.
  </p>

  <ul class="template-list">
    {templates.map(t => (
      <li>
        <div class="template-head">
          <h3>{t.title}</h3>
          <span class="format-badge">{t.format}</span>
        </div>
        <p>{t.description}</p>
        <a class="download-link" href={t.href} download>Download template ({t.format})</a>
      </li>
    ))}
  </ul>
</IntranetLayout>

<style>
  .state-notation {
    font-size: var(--font-size-small);
    font-style: italic;
    color: var(--color-text-muted);
    margin-top: calc(var(--space-2) * -1);
    margin-bottom: var(--space-5);
  }
  .lede {
    font-size: 1.125rem;
    line-height: var(--leading-snug);
    max-width: var(--content-max-width);
    margin-bottom: var(--space-5);
  }
  .template-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--content-max-width);
  }
  .template-list li {
    padding: var(--space-4) 0;
    border-bottom: var(--border-1);
  }
  .template-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .template-head h3 {
    font-size: var(--font-size-h3);
    margin: 0 0 var(--space-1) 0;
  }
  .format-badge {
    font-size: var(--font-size-caption);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border: var(--border-1);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
  }
  .template-list p {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2) 0;
  }
  .download-link {
    display: inline-block;
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }
</style>
